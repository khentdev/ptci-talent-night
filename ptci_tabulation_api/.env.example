# ---------- Server ----------
PORT=3001
HOST=0.0.0.0
# development | production  (production => secure cookies, SameSite=None)
NODE_ENV=development

# Comma-separated frontend origins allowed by CORS (NO trailing slash).
# Local Vite origins (http://localhost:5173 / 5174) are added automatically OUTSIDE production.
# On Hostinger/Render set your deployed frontend URL, e.g. https://tabulation.example.com  (required in production)
CORS_ORIGIN=

# Which reverse proxies may set X-Forwarded-For / X-Forwarded-Proto.
# auto (default) = loopback, linklocal, uniquelocal — right for Hostinger, Render, nginx on the same box/private net.
# Use "true" only if your proxy is on a public IP (clients could then spoof their IP), "false" for no proxy.
TRUST_PROXY=auto

# ---------- MySQL (Hostinger hPanel -> Databases -> MySQL Databases) ----------
# When the API runs ON Hostinger, MYSQL_HOST is usually "localhost".
# For local dev against Hostinger, enable Remote MySQL for your IP and use the remote host.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ic2_tabulation
# set to true if your provider requires TLS for remote connections
MYSQL_SSL=false

# ---------- Auth ----------
# REQUIRED. Long random string (min 32 chars; placeholders are rejected at boot).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Session lifetime, e.g. 12h, 1d, 7d
JWT_EXPIRES_IN=1d

# Session cookie. Leave defaults unless the API and frontend are on different sites.
COOKIE_NAME=ic2_token
# auto => secure only in production. Override with true/false.
COOKIE_SECURE=auto
# auto => "none" in production (works cross-site over HTTPS), "lax" in development.
# Subdomain setup (api.yourdomain.com + yourdomain.com = same site): set COOKIE_SAME_SITE=lax (safer).
COOKIE_SAME_SITE=auto
# Optional, e.g. .example.com to share the cookie between api.example.com and example.com
COOKIE_DOMAIN=

# ---------- Seeding (npm run seed) ----------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
# Number of judge accounts to create (judge1..judgeN) — 0 to skip
SEED_JUDGES=0
SEED_JUDGE_PASSWORD=
# true => insert 10 male + 10 female sample contestants (only when the table is empty)
SEED_SAMPLE_CONTESTANTS=false
