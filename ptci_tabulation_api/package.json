{
  "name": "ic2-tabulation-api",
  "version": "1.0.0",
  "private": true,
  "description": "IC2 Pageant Tabulation API — Fastify + TypeScript + MySQL backend for the Vue tabulation frontend",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx src/db/initSchema.ts",
    "seed": "tsx src/db/seed.ts",
    "test:api": "tsx test/api.test.ts",
    "pack:hostinger": "node scripts/pack-hostinger.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@types/node": "^24.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "jose": "^6.2.10",
    "mysql2": "^3.24.2",
    "typescript": "^5.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.23.12"
  }
}
